{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SMB X", "version": "1.0.0", "identifier": "dev.transx.smb",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "SMB X", "width": 1100, "height": 720, "minWidth": 840, "minHeight": 520, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'" }
  },
  "bundle": { "active": true, "targets": "all", "resources": { "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt", "../LICENSE": "LICENSE", "../THIRD_PARTY_SOURCES.tar.gz": "THIRD_PARTY_SOURCES.tar.gz" }, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"], "macOS": { "minimumSystemVersion": "11.0" }, "windows": { "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": true } } }
}
